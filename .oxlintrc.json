{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "es2024": true,
    "node": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-unused-vars": "error",
    "no-console": "off"
  },
  "ignorePatterns": [
    "lib",
    "client",
    "node_modules"
  ]
}
