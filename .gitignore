# Dependencies (install with npm ci)
/node_modules/

# Build output is committed on purpose: `github:` installs run no build scripts
# (pnpm blocks them unless allowBuilds is edited), so lib/ and client/ must be
# in the repository. Rebuild with `npm run build` before committing source.
*.tgz
*.tsbuildinfo

# Documentation is kept outside the repository on purpose
/docs/

# DSH workspace data and agent/tooling artifacts — never source
/.dsh/
/.playwright-cli/
/.dsh-code-index/
/.dsh-tmp/
/.dsh-spill/

# Logs and OS noise
*.log
npm-debug.log*
.DS_Store
